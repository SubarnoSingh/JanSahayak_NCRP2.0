# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── Database (required) ─────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ncrp2

# ── AI — the only credential needed for AI features ─────
# Empty key = built-in heuristic engine (app still fully works).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Speech-to-text ──────────────────────────────────────
# auto     → OpenAI Whisper via OPENAI_API_KEY if present, else external URL, else browser-only
# openai   → force OpenAI Audio API (reuses OPENAI_API_KEY — no second key needed)
# external → use WHISPER_API_URL (+ optional WHISPER_API_KEY)
# off      → server STT disabled; browser Web Speech API remains available
WHISPER_PROVIDER=auto
WHISPER_API_URL=
WHISPER_API_KEY=

# ── Bhashini translation (fully optional) ───────────────
# false = never contacted; mock provider answers instead. No errors when empty.
BHASHINI_ENABLED=false
BHASHINI_API_KEY=
BHASHINI_API_URL=

# ── Government integrations (mock | production) ─────────
# "production" requires the matching *_API_URL. Mocks return clearly-labelled
# synthetic demo data and never contact real systems.
CFCFRMS_MODE=mock
CFCFRMS_API_URL=
EPRAMAAN_MODE=mock
EPRAMAAN_API_URL=
CEIR_MODE=mock
CEIR_API_URL=
TAFCOP_MODE=mock
TAFCOP_API_URL=

# ── Security ────────────────────────────────────────────
JWT_SECRET=change-me-in-production
# DEMO credentials for /hq sign-in — development only.
OFFICER_DEMO_EMAIL=io@ncrp.demo
OFFICER_DEMO_PASSWORD=JaiHind2026

# ── Uploads ─────────────────────────────────────────────
MAX_UPLOAD_MB=10
UPLOAD_DIR=uploads
